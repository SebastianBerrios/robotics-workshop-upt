---
import { Image } from 'astro:assets';
import logo from '../assets/logo-upt.png';
---
<header class="hdr">
  <div class="container bar">
    <a href="#inicio" class="brand" aria-label="Universidad Privada de Tacna, inicio">
      <Image src={logo} alt="UPT - Universidad Privada de Tacna" height={32} loading="eager" />
    </a>
    <nav aria-label="Principal">
      <a href="#talleres">Talleres</a>
      <a href="#cronograma">Cronograma</a>
      <a href="#instructor">Instructor</a>
      <a href="#faq">FAQ</a>
    </nav>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(6, 20, 54, 0.82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand img { height: 32px; width: auto; }
  nav { display: flex; gap: 22px; }
  nav a { text-decoration: none; color: var(--muted); font-weight: 500; font-size: 0.95rem; transition: color 0.2s; }
  nav a:hover { color: var(--cyan); }
  @media (max-width: 640px) { nav { display: none; } }
</style>
