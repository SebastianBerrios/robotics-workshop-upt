---
import { faqs } from '../data/workshops';
---
<section id="faq" class="section alt">
  <div class="container narrow">
    <p class="eyebrow">Resolvemos tus dudas</p>
    <h2 class="section-title">Preguntas frecuentes</h2>
    <div class="list">
      {faqs.map((f) => (
        <details class="reveal">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .alt { background: var(--bg-2); }
  .narrow { max-width: 800px; }
  .list { margin-top: 32px; display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); }
  summary { cursor: pointer; padding: 18px 22px; font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--cyan); font-size: 1.5rem; line-height: 1; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 22px 20px; color: var(--muted); }
</style>
